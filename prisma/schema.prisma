generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String
  products    Busbar[]
  component   Component[]
}

model Brand {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  busbars     Busbar[]
  series      Series[]
  components  Component[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model BusbarType {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  busbars     Busbar[]
  components  Component[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Series {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  brandId     Int
  brand       Brand       @relation(fields: [brandId], references: [id])
  busbars     Busbar[]
  components  Component[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Busbar {
  id          Int                @id @default(autoincrement())
  name        String
  slug        String             @unique
  amperage    Int
  description String?
  imageUrl    String?
  specs       Json
  price       Float?
  drawingUrl  String?
  views        Int               @default(0)
  isFeatured   Boolean           @default(false)
  categoryId  Int
  category    Category           @relation(fields: [categoryId], references: [id])
  brandId     Int
  brand       Brand              @relation(fields: [brandId], references: [id])
  typeId      Int
  type        BusbarType         @relation(fields: [typeId], references: [id])
  seriesId    Int
  series      Series             @relation(fields: [seriesId], references: [id])

  components  BusbarComponent[] // 🔹 теперь опционально
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Component {
  id          Int                @id @default(autoincrement())
  name        String
  slug        String             @unique
  description String?
  isOptional  Boolean            @default(false)
  imageUrl    String?
  drawingUrl  String?
  specs       Json?
  price       Float?
  views        Int       @default(0)
  isFeatured   Boolean   @default(false)

  categoryId  Int
  category    Category           @relation(fields: [categoryId], references: [id])
  brandId     Int
  brand       Brand              @relation(fields: [brandId], references: [id])
  typeId      Int
  busbarType  BusbarType         @relation(fields: [typeId], references: [id])
  seriesId    Int
  series      Series             @relation(fields: [seriesId], references: [id])

  busbars     BusbarComponent[] // 🔹 теперь опционально
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

/// Join-модель для Busbar ↔ Component
model BusbarComponent {
  id          Int       @id @default(autoincrement())
  busbarId    Int
  componentId Int
  quantity    Int       @default(1)
  isDefault   Boolean   @default(true)

  busbar      Busbar    @relation(fields: [busbarId], references: [id])
  component   Component @relation(fields: [componentId], references: [id])

  @@unique([busbarId, componentId]) // 🔹 чтобы не было дублей
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  message   String
  productId Int?
  createdAt DateTime @default(now())
}
